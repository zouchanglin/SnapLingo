<Window x:Class="SnapLingo.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Cursor="None">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <!-- Dark overlay with hole for selection -->
        <Path x:Name="OverlayPath" Fill="#80000000" IsHitTestVisible="False"/>
        <!-- Selection border -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#FF1E90FF"
                   StrokeThickness="2"
                   Fill="Transparent"
                   Visibility="Collapsed"/>
        <!-- Custom crosshair cursor -->
        <Canvas x:Name="Crosshair" IsHitTestVisible="False">
            <!-- Horizontal line with white stroke + dark outline -->
            <Line x:Name="CrossH1" Stroke="#AA000000" StrokeThickness="3" X1="-16" Y1="0" X2="16" Y2="0"/>
            <Line x:Name="CrossH2" Stroke="White" StrokeThickness="1.5" X1="-16" Y1="0" X2="16" Y2="0"/>
            <!-- Vertical line with white stroke + dark outline -->
            <Line x:Name="CrossV1" Stroke="#AA000000" StrokeThickness="3" X1="0" Y1="-16" X2="0" Y2="16"/>
            <Line x:Name="CrossV2" Stroke="White" StrokeThickness="1.5" X1="0" Y1="-16" X2="0" Y2="16"/>
            <!-- Center dot -->
            <Ellipse Width="4" Height="4" Fill="#FFFF4444" Canvas.Left="-2" Canvas.Top="-2"/>
        </Canvas>
        <!-- Magnifier -->
        <Canvas x:Name="MagnifierCanvas" IsHitTestVisible="False" Visibility="Visible">
            <Border x:Name="MagnifierBorder" Width="150" Height="93"
                    CornerRadius="4" BorderBrush="#CC1E90FF" BorderThickness="2"
                    ClipToBounds="True" Background="Black">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                </Border.Effect>
                <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <!-- Magnifier crosshair -->
            <Line Stroke="#661E90FF" StrokeThickness="1" X1="75" Y1="32" X2="75" Y2="42"/>
            <Line Stroke="#661E90FF" StrokeThickness="1" X1="75" Y1="51" X2="75" Y2="61"/>
            <Line Stroke="#661E90FF" StrokeThickness="1" X1="60" Y1="46.5" X2="70" Y2="46.5"/>
            <Line Stroke="#661E90FF" StrokeThickness="1" X1="80" Y1="46.5" X2="90" Y2="46.5"/>
            <!-- Coordinate text -->
            <Border x:Name="MagnifierCoordBorder" Canvas.Top="97" Canvas.Left="25"
                    Background="#CC000000" CornerRadius="3" Padding="6,2">
                <TextBlock x:Name="TxtMagnifierCoord" Foreground="White" FontSize="11"
                           FontFamily="Consolas" Text="0, 0"/>
            </Border>
        </Canvas>
    </Canvas>
</Window>
