<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
    <Package Name="SnapLingo"
             Manufacturer="zouchanglin"
             Version="0.1.0"
             UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

        <MajorUpgrade DowngradeErrorMessage="A newer version of SnapLingo is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Feature Id="Main" Title="SnapLingo" Level="1">
            <ComponentGroupRef Id="PublishFiles" />
            <ComponentRef Id="StartMenuShortcut" />
        </Feature>

        <StandardDirectory Id="ProgramFiles6432Folder">
            <Directory Id="INSTALLFOLDER" Name="SnapLingo">
                <Component Id="StartMenuShortcut" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
                    <RegistryValue Root="HKCU" Key="Software\SnapLingo" Name="installed" Type="integer" Value="1" KeyPath="yes" />
                    <Shortcut Id="StartMenuShortcut"
                              Name="SnapLingo"
                              Target="[INSTALLFOLDER]SnapLingo.exe"
                              WorkingDirectory="INSTALLFOLDER"
                              Directory="ProgramMenuFolder"
                              Icon="AppIcon" />
                    <RemoveFolder Id="RemoveStartMenuFolder" Directory="ProgramMenuFolder" On="uninstall" />
                </Component>
            </Directory>
        </StandardDirectory>

        <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\SnapLingo.exe" />

        <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    </Package>

    <Fragment>
        <ComponentGroup Id="PublishFiles" Directory="INSTALLFOLDER">
            <Files Include="$(var.PublishDir)\**" />
        </ComponentGroup>
    </Fragment>
</Wix>
