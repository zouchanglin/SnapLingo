<Window x:Class="SnapLingo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="500" Width="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="16,0,4,0">
                    <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="&#x2715;" Style="{StaticResource CloseButton}"
                            Click="BtnCancel_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                       Fill="{StaticResource BorderBrush}"/>

            <!-- Body: Sidebar + Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation -->
                <StackPanel Grid.Column="0" Margin="12,16,8,0">
                    <RadioButton x:Name="NavModels" Content="模型配置" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}" IsChecked="True"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPrompt" Content="提示词" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHotkey" Content="快捷键" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Content="关于" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"/>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}"/>

                <!-- Content Pages -->
                <Grid Grid.Column="2" Margin="20,16,20,12">
                    <!-- Models Page -->
                    <Grid x:Name="PageModels">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="配置 OpenAI 兼容格式的模型 API" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Model list -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="LstModels" Grid.Row="0"
                                         SelectionChanged="LstModels_SelectionChanged"
                                         Background="{StaticResource CardBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1" Padding="2"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="+" Style="{StaticResource GhostButton}"
                                            Click="BtnAddModel_Click" FontSize="12"
                                            Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="-" Style="{StaticResource GhostButton}"
                                            Click="BtnRemoveModel_Click" FontSize="12"
                                            Padding="8,4"/>
                                </StackPanel>
                            </Grid>

                            <!-- Model edit form -->
                            <StackPanel Grid.Column="2" x:Name="PanelModelEdit">
                                <TextBlock Text="显示名称" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtModelName" Style="{StaticResource ModernTextBox}"
                                         FontSize="12.5" Margin="0,0,0,10" TextChanged="ModelField_TextChanged"/>

                                <TextBlock Text="API 端点 (Endpoint)" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtModelEndpoint" Style="{StaticResource ModernTextBox}"
                                         FontSize="12.5" Margin="0,0,0,10" TextChanged="ModelField_TextChanged"/>

                                <TextBlock Text="API Key" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtModelApiKey" Style="{StaticResource ModernTextBox}"
                                         FontSize="12.5" Margin="0,0,0,10" TextChanged="ModelField_TextChanged"/>

                                <TextBlock Text="模型名 (Model)" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtModelModel" Style="{StaticResource ModernTextBox}"
                                         FontSize="12.5" Margin="0,0,0,0" TextChanged="ModelField_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Prompt Page -->
                    <Grid x:Name="PagePrompt" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="自定义翻译提示词" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="使用 {text} 代表 OCR 识别结果" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
                        <TextBox Grid.Row="2" x:Name="TxtPrompt" Style="{StaticResource ModernTextBox}"
                                 FontSize="12.5" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="10"/>
                        <Button Grid.Row="3" Content="恢复默认" Style="{StaticResource GhostButton}"
                                Click="BtnResetPrompt_Click" HorizontalAlignment="Left"
                                Margin="0,10,0,0" FontSize="12"/>
                    </Grid>

                    <!-- Hotkey Page -->
                    <StackPanel x:Name="PageHotkey" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="截图快捷键" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="点击下方输入框，然后按下你想设置的组合键" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
                        <TextBox x:Name="TxtHotkey" Style="{StaticResource ModernTextBox}"
                                 FontSize="14" IsReadOnly="True" Cursor="Hand"
                                 PreviewKeyDown="TxtHotkey_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TxtHotkey_MouseDown"
                                 LostFocus="TxtHotkey_LostFocus"
                                 Width="260" HorizontalAlignment="Left"
                                 Padding="14" FontWeight="Medium"/>
                    </StackPanel>

                    <!-- About Page -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#x26A1;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="SnapLingo" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="v1.0.0" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="22"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   MaxWidth="320">
                            截图 → OCR 文字识别 → 多模型并发翻译
                            <LineBreak/>
                            支持配置多个 OpenAI 兼容 API
                            <LineBreak/>
                            对比不同模型的翻译结果
                        </TextBlock>

                        <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="12.5">
                            <Run Text="作者：" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Hyperlink x:Name="LinkAuthor" Click="LinkAuthor_Click"
                                       Foreground="{StaticResource PrimaryBrush}">
                                https://github.com/zouchanglin
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom buttons -->
            <Border Grid.Row="2" Padding="20,12" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource GhostButton}"
                            Click="BtnCancel_Click" Margin="0,0,10,0"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButton}"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
