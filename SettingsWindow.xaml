<Window x:Class="SnapLingo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="560" Width="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="16,0,4,0">
                    <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="&#x2715;" Style="{StaticResource CloseButton}"
                            Click="BtnCancel_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                       Fill="{StaticResource BorderBrush}"/>

            <!-- Body: Sidebar + Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation -->
                <StackPanel Grid.Column="0" Margin="12,16,8,0">
                    <RadioButton x:Name="NavModels" Content="模型配置" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}" IsChecked="True"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavOcr" Content="OCR服务" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPrompt" Content="提示词" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHotkey" Content="快捷键" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Content="关于" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"/>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}"/>

                <!-- Content Pages -->
                <Grid Grid.Column="2" Margin="20,16,20,12">
                    <!-- Models Page -->
                    <Grid x:Name="PageModels">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="配置 OpenAI 兼容格式的模型 API" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Model list -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="LstModels" Grid.Row="0"
                                         SelectionChanged="LstModels_SelectionChanged"
                                         Background="{StaticResource CardBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1" Padding="2"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="+" Style="{StaticResource GhostButton}"
                                            Click="BtnAddModel_Click" FontSize="12"
                                            Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="-" Style="{StaticResource GhostButton}"
                                            Click="BtnRemoveModel_Click" FontSize="12"
                                            Padding="8,4"/>
                                </StackPanel>
                            </Grid>

                            <!-- Model edit form -->
                            <StackPanel Grid.Column="2" x:Name="PanelModelEdit">
                                <TextBlock Text="显示名称" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtModelName" Style="{StaticResource ModernTextBox}"
                                         FontSize="12.5" Margin="0,0,0,10" TextChanged="ModelField_TextChanged"/>

                                <TextBlock Text="API 端点 (Endpoint)" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtModelEndpoint" Style="{StaticResource ModernTextBox}"
                                         FontSize="12.5" Margin="0,0,0,10" TextChanged="ModelField_TextChanged"/>

                                <TextBlock Text="API Key" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PwdModelApiKey" FontSize="12.5"
                                                 PasswordChanged="PwdModelApiKey_Changed"
                                                 Padding="8,6" Background="{StaticResource CardBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    <TextBox x:Name="TxtModelApiKey" Style="{StaticResource ModernTextBox}"
                                             FontSize="12.5" Visibility="Collapsed"
                                             TextChanged="ModelField_TextChanged"/>
                                    <Button Grid.Column="1" Content="&#x1F441;" FontSize="11"
                                            Style="{StaticResource GhostButton}" Padding="6,4" Margin="4,0,0,0"
                                            PreviewMouseLeftButtonDown="ShowModelApiKey_Down"
                                            PreviewMouseLeftButtonUp="ShowModelApiKey_Up"/>
                                </Grid>

                                <TextBlock Text="模型名 (Model)" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtModelModel" Style="{StaticResource ModernTextBox}"
                                         FontSize="12.5" Margin="0,0,0,0" TextChanged="ModelField_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- OCR Page -->
                    <Grid x:Name="PageOcr" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="配置 OCR 识别服务（标记 ★ 为当前使用）" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- OCR list -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="LstOcr" Grid.Row="0"
                                         SelectionChanged="LstOcr_SelectionChanged"
                                         Background="{StaticResource CardBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1" Padding="2"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="+" Style="{StaticResource GhostButton}"
                                            Click="BtnAddOcr_Click" FontSize="12"
                                            Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="-" Style="{StaticResource GhostButton}"
                                            Click="BtnRemoveOcr_Click" FontSize="12"
                                            Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="&#x2605;" Style="{StaticResource GhostButton}"
                                            Click="BtnSetActiveOcr_Click" FontSize="12"
                                            Padding="8,4" ToolTip="设为当前使用"/>
                                </StackPanel>
                            </Grid>

                            <!-- OCR edit form -->
                            <StackPanel Grid.Column="2" x:Name="PanelOcrEdit">
                                <TextBlock Text="显示名称" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtOcrName" Style="{StaticResource ModernTextBox}"
                                         FontSize="12.5" Margin="0,0,0,10" TextChanged="OcrField_TextChanged"/>

                                <TextBlock Text="识别服务类型" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbOcrProvider" Width="260" HorizontalAlignment="Left"
                                          Margin="0,0,0,14" SelectionChanged="CmbOcrProvider_SelectionChanged">
                                    <ComboBoxItem Content="Windows 本地 OCR" Tag="Windows"/>
                                    <ComboBoxItem Content="火山引擎多语种 OCR" Tag="Volcengine"/>
                                    <ComboBoxItem Content="百度 OCR" Tag="Baidu"/>
                                    <ComboBoxItem Content="腾讯云 OCR" Tag="Tencent"/>
                                </ComboBox>

                                <!-- Volcengine -->
                                <StackPanel x:Name="PanelVolcengineOcr">
                                    <TextBlock Text="Access Key ID" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="PwdOcrAccessKeyId" FontSize="12.5"
                                                     PasswordChanged="PwdOcrAccessKeyId_Changed"
                                                     Padding="8,6" Background="{StaticResource CardBrush}"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <TextBox x:Name="TxtOcrAccessKeyId" Style="{StaticResource ModernTextBox}"
                                                 FontSize="12.5" Visibility="Collapsed"
                                                 TextChanged="OcrField_TextChanged"/>
                                        <Button Grid.Column="1" Content="&#x1F441;" FontSize="11"
                                                Style="{StaticResource GhostButton}" Padding="6,4" Margin="4,0,0,0"
                                                PreviewMouseLeftButtonDown="ShowOcrAccessKeyId_Down"
                                                PreviewMouseLeftButtonUp="ShowOcrAccessKeyId_Up"/>
                                    </Grid>

                                    <TextBlock Text="Secret Access Key" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="PwdOcrSecretKey" FontSize="12.5"
                                                     PasswordChanged="PwdOcrSecretKey_Changed"
                                                     Padding="8,6" Background="{StaticResource CardBrush}"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <TextBox x:Name="TxtOcrSecretKey" Style="{StaticResource ModernTextBox}"
                                                 FontSize="12.5" Visibility="Collapsed"
                                                 TextChanged="OcrField_TextChanged"/>
                                        <Button Grid.Column="1" Content="&#x1F441;" FontSize="11"
                                                Style="{StaticResource GhostButton}" Padding="6,4" Margin="4,0,0,0"
                                                PreviewMouseLeftButtonDown="ShowOcrSecretKey_Down"
                                                PreviewMouseLeftButtonUp="ShowOcrSecretKey_Up"/>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6">
                                        需要在火山引擎开通多语种 OCR，并给访问密钥授权 CV 相关权限。
                                    </TextBlock>
                                    <TextBlock FontSize="12">
                                        <Hyperlink Click="LinkVolcengine_Click"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            获取 API Key
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Baidu -->
                                <StackPanel x:Name="PanelBaiduOcr" Visibility="Collapsed">
                                    <TextBlock Text="API Key" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="PwdBaiduApiKey" FontSize="12.5"
                                                     PasswordChanged="PwdBaiduApiKey_Changed"
                                                     Padding="8,6" Background="{StaticResource CardBrush}"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <TextBox x:Name="TxtBaiduApiKey" Style="{StaticResource ModernTextBox}"
                                                 FontSize="12.5" Visibility="Collapsed"
                                                 TextChanged="OcrField_TextChanged"/>
                                        <Button Grid.Column="1" Content="&#x1F441;" FontSize="11"
                                                Style="{StaticResource GhostButton}" Padding="6,4" Margin="4,0,0,0"
                                                PreviewMouseLeftButtonDown="ShowBaiduApiKey_Down"
                                                PreviewMouseLeftButtonUp="ShowBaiduApiKey_Up"/>
                                    </Grid>

                                    <TextBlock Text="Secret Key" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="PwdBaiduSecretKey" FontSize="12.5"
                                                     PasswordChanged="PwdBaiduSecretKey_Changed"
                                                     Padding="8,6" Background="{StaticResource CardBrush}"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <TextBox x:Name="TxtBaiduSecretKey" Style="{StaticResource ModernTextBox}"
                                                 FontSize="12.5" Visibility="Collapsed"
                                                 TextChanged="OcrField_TextChanged"/>
                                        <Button Grid.Column="1" Content="&#x1F441;" FontSize="11"
                                                Style="{StaticResource GhostButton}" Padding="6,4" Margin="4,0,0,0"
                                                PreviewMouseLeftButtonDown="ShowBaiduSecretKey_Down"
                                                PreviewMouseLeftButtonUp="ShowBaiduSecretKey_Up"/>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6">
                                        需要在百度智能云创建文字识别应用，获取 API Key 和 Secret Key。
                                    </TextBlock>
                                    <TextBlock FontSize="12">
                                        <Hyperlink Click="LinkBaidu_Click"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            获取 API Key
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Tencent -->
                                <StackPanel x:Name="PanelTencentOcr" Visibility="Collapsed">
                                    <TextBlock Text="SecretId（以 AKID 开头）" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="PwdTencentSecretId" FontSize="12.5"
                                                     PasswordChanged="PwdTencentSecretId_Changed"
                                                     Padding="8,6" Background="{StaticResource CardBrush}"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <TextBox x:Name="TxtTencentSecretId" Style="{StaticResource ModernTextBox}"
                                                 FontSize="12.5" Visibility="Collapsed"
                                                 TextChanged="OcrField_TextChanged"/>
                                        <Button Grid.Column="1" Content="&#x1F441;" FontSize="11"
                                                Style="{StaticResource GhostButton}" Padding="6,4" Margin="4,0,0,0"
                                                PreviewMouseLeftButtonDown="ShowTencentSecretId_Down"
                                                PreviewMouseLeftButtonUp="ShowTencentSecretId_Up"/>
                                    </Grid>

                                    <TextBlock Text="SecretKey" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="PwdTencentSecretKey" FontSize="12.5"
                                                     PasswordChanged="PwdTencentSecretKey_Changed"
                                                     Padding="8,6" Background="{StaticResource CardBrush}"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <TextBox x:Name="TxtTencentSecretKey" Style="{StaticResource ModernTextBox}"
                                                 FontSize="12.5" Visibility="Collapsed"
                                                 TextChanged="OcrField_TextChanged"/>
                                        <Button Grid.Column="1" Content="&#x1F441;" FontSize="11"
                                                Style="{StaticResource GhostButton}" Padding="6,4" Margin="4,0,0,0"
                                                PreviewMouseLeftButtonDown="ShowTencentSecretKey_Down"
                                                PreviewMouseLeftButtonUp="ShowTencentSecretKey_Up"/>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6">
                                        需要在腾讯云开通文字识别 OCR 服务，获取 API 密钥。
                                    </TextBlock>
                                    <TextBlock FontSize="12">
                                        <Hyperlink Click="LinkTencent_Click"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            获取 API Key
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Prompt Page -->
                    <Grid x:Name="PagePrompt" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="自定义翻译提示词" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="使用 {text} 代表 OCR 识别结果" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
                        <TextBox Grid.Row="2" x:Name="TxtPrompt" Style="{StaticResource ModernTextBox}"
                                 FontSize="12.5" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="10"/>
                        <Button Grid.Row="3" Content="恢复默认" Style="{StaticResource GhostButton}"
                                Click="BtnResetPrompt_Click" HorizontalAlignment="Left"
                                Margin="0,10,0,0" FontSize="12"/>
                    </Grid>

                    <!-- Hotkey Page -->
                    <StackPanel x:Name="PageHotkey" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="截图快捷键" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="点击下方输入框，然后按下你想设置的组合键" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
                        <TextBox x:Name="TxtHotkey" Style="{StaticResource ModernTextBox}"
                                 FontSize="14" IsReadOnly="True" Cursor="Hand"
                                 PreviewKeyDown="TxtHotkey_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TxtHotkey_MouseDown"
                                 LostFocus="TxtHotkey_LostFocus"
                                 Width="260" HorizontalAlignment="Left"
                                 Padding="14" FontWeight="Medium"/>

                        <Separator Margin="0,24,0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="启动选项" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkAutoStart" Content="开机自启动" FontSize="12.5"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- About Page -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#x26A1;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="SnapLingo" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="v0.1.0" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="22"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   MaxWidth="320">
                            截图 → OCR 文字识别 → 多模型并发翻译
                            <LineBreak/>
                            支持配置多个 OpenAI 兼容 API
                            <LineBreak/>
                            对比不同模型的翻译结果
                        </TextBlock>

                        <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="12.5">
                            <Run Text="作者：" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Hyperlink x:Name="LinkAuthor" Click="LinkAuthor_Click"
                                       Foreground="{StaticResource PrimaryBrush}">
                                https://github.com/zouchanglin/SnapLingo
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom buttons -->
            <Border Grid.Row="2" Padding="20,12" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,8,8">
                <DockPanel>
                    <TextBlock x:Name="TxtSaveStatus" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Content="取消" Style="{StaticResource GhostButton}"
                                Click="BtnCancel_Click" Margin="0,0,10,0"/>
                        <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
